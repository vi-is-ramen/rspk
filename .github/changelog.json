{
  "categories": [
    {
      "title": "### Features",
      "labels": ["feature", "enhancement"]
    },
    {
      "title": "### Bug Fixes",
      "labels": ["bug", "fix"]
    },
    {
      "title": "### New Package Managers",
      "labels": ["new-manager"]
    },
    {
      "title": "### Refactoring",
      "labels": ["refactor"]
    },
    {
      "title": "### Documentation",
      "labels": ["documentation"]
    }
  ],
  "ignore_labels": ["duplicate", "wontfix", "question"],
  "sort": "ASC",
  "template": "${{CHANGELOG}}",
  "pr_template": "- ${{TITLE}} (#${{NUMBER}}) by @${{AUTHOR}}"
}
